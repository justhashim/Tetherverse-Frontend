# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# cloudflare workers
# The OpenNext build output and the wrangler local state are both generated.
/.open-next/
/.wrangler/
worker-configuration.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# `env.prod` and `env.example` have no leading dot, so `.env*` does not match them.
# Neither holds a secret: every value is a URL or a browser-visible origin. They are
# committed on purpose so a production config is reviewable in a diff.
env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
