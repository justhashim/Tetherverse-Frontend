# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# cloudflare workers
# The OpenNext build output and the wrangler local state are both generated.
/.open-next/
/.wrangler/
worker-configuration.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# `.env` itself is the exception, and it is committed on purpose: it carries the
# two NEXT_PUBLIC_* origins the build cannot run without, and both are public
# values the browser is told anyway. Nothing secret goes in it, and the backend
# address is not there at all - it is read at runtime from the Worker's own
# configuration so it can change without a rebuild.
!.env

# Local overrides and conveniences. Ignored so a developer's LAN origin or a
# personal backend address cannot reach a deployed Worker.
env.prod
env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#agents
.agents/
