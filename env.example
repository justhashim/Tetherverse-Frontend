#TETHERVERSE FRONTEND
#
# This app holds no database code and no database credentials. It forwards its API
# routes to the Tetherverse API, which owns the Postgres schema.
#
# ── Two kinds of variable, and the difference matters on Cloudflare Workers ──
#
# NEXT_PUBLIC_* variables are inlined into the client bundle at BUILD time. On
# Workers that means changing one requires a rebuild and a redeploy, not just a
# secret update. They are read from env.prod at build time, which is why that
# file is committed.
#
# Non-prefixed variables are read at RUNTIME. On Workers they are set as Worker
# secrets, so the backend address can change without a rebuild.
#
# ── Where each one goes ────────────────────────────────────────────────────
#
#   TETHERVERSE_API_URL            runtime. A Worker secret, or .env.local here.
#   NEXT_PUBLIC_EXCEL_AUTH_FRONTEND_URL   build time. env.prod.
#   NEXT_PUBLIC_LAUNCHER_ORIGIN     build time. env.prod.
#   ALLOWED_DEV_ORIGINS             build time, dev only. env.local.
#
# Address of the Tetherverse API (GCP Cloud Run).
#
# SERVER-SIDE ONLY. Do not prefix this with NEXT_PUBLIC_: that would inline it into
# the client bundle and publish the backend's address to every player.
#
# On Cloudflare Workers, set it as a secret so the address can change without a
# rebuild:
#
#   wrangler secret put TETHERVERSE_API_URL
#
TETHERVERSE_API_URL=http://localhost:4000

# Excel Play sign-in. Both are browser-facing by design.
NEXT_PUBLIC_EXCEL_AUTH_FRONTEND_URL=https://auth.excelmec.org

# Origin of the ExcelPlay-Launcher, used to accept the bridged auth token in an
# iframe. Must list every origin that embeds this app, and nothing else.
NEXT_PUBLIC_LAUNCHER_ORIGIN=http://localhost:3000

# Origins allowed to load the dev server, comma-separated. Local development only;
# this file is read by next.config.ts, never shipped to the browser.
ALLOWED_DEV_ORIGINS=
